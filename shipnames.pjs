// {"author":"jvde-github","version": 5, "description":"overriding shipnames"}

if (typeof AISCatcher !== 'undefined' && AISCatcher.PLUGIN_API_VERSION >= 5) {
    const shipNames = {
        2442006: { name: "Lighthouse", callsign: "CG1212" },
        244770939: { name: "VTS" }
    };

    // Returning null/undefined falls through to ship.shipname / ship.callsign.
    AISCatcher.setShipNameProvider((ship) => shipNames[ship.mmsi]?.name);
    AISCatcher.setCallSignProvider((ship) => shipNames[ship.mmsi]?.callsign);
}
