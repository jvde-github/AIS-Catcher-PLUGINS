// {"author":"jvde-github","version": 3, "description":"add option to look up vessel name in Google"}

addShipcardItem(
  'search',
  'Google',
  'Lookup vessel name in Google',
  "card_mmsi in shipsDB && window.open('https://www.google.com/search?q=' + (shipsDB[card_mmsi].raw.shipname ? shipsDB[card_mmsi].raw.shipname : shipsDB[card_mmsi].raw.mmsi));"
);
