// {"author":"jvde-github","version": 4, "description":"add option to look up vessel name in Google"}

if (typeof AISCatcher !== 'undefined' && AISCatcher.PLUGIN_API_VERSION >= 4) {
    AISCatcher.addShipcardItem('search', 'Google', 'Lookup vessel name in Google', () => {
        const mmsi = AISCatcher.card_mmsi;
        if (mmsi in AISCatcher.shipsDB) {
            const ship = AISCatcher.shipsDB[mmsi].raw;
            const q = ship.shipname || ship.mmsi;
            window.open('https://www.google.com/search?q=' + encodeURIComponent(q));
        }
    });
}
